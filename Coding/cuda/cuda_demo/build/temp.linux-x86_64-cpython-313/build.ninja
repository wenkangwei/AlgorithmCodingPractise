ninja_required_version = 1.3
cxx = /home/wwk/workspace/miniconda3/envs/llm_study/bin/x86_64-conda-linux-gnu-c++
nvcc = /home/wwk/workspace/miniconda3/envs/llm_study/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/wwk/workspace/miniconda3/envs/llm_study/include -I/home/wwk/workspace/miniconda3/envs/llm_study/targets/x86_64-linux/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/wwk/workspace/miniconda3/envs/llm_study/include -I/home/wwk/workspace/miniconda3/envs/llm_study/targets/x86_64-linux/include -fPIC -I/home/wwk/workspace/miniconda3/envs/llm_study/lib/python3.13/site-packages/torch/include -I/home/wwk/workspace/miniconda3/envs/llm_study/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -I/home/wwk/workspace/miniconda3/envs/llm_study/include -I/home/wwk/workspace/miniconda3/envs/llm_study/include/python3.13 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=sum_double_cuda -std=c++17
cuda_cflags = -I/home/wwk/workspace/miniconda3/envs/llm_study/lib/python3.13/site-packages/torch/include -I/home/wwk/workspace/miniconda3/envs/llm_study/lib/python3.13/site-packages/torch/include/torch/csrc/api/include -I/home/wwk/workspace/miniconda3/envs/llm_study/include -I/home/wwk/workspace/miniconda3/envs/llm_study/include/python3.13 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H -DTORCH_EXTENSION_NAME=sum_double_cuda -gencode=arch=compute_120,code=sm_120 -ccbin /home/wwk/workspace/miniconda3/envs/llm_study/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







